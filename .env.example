# DrawPath AI — .env.example
# ---------------------------------------------------------------------------
# Sao chép thành .env để chạy local / Docker Compose:
#   cp .env.example .env
# Sau đó SỬA các giá trị nhạy cảm (SECRET_KEY, POSTGRES_PASSWORD...).
# KHÔNG BAO GIỜ commit file .env thật. Mọi giá trị dưới đây chỉ là
# placeholder an toàn, không phải secret thật.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL, dùng trong Docker Compose) ---
POSTGRES_USER=drawpath
POSTGRES_PASSWORD=drawpath
POSTGRES_DB=drawpath
DATABASE_URL=postgresql+psycopg2://drawpath:drawpath@db:5432/drawpath
# Khi chạy backend local không Docker (mặc định SQLite của code hiện tại):
# DATABASE_URL=<redacted>

# --- Redis (hàng đợi / cache — mục tiêu, chưa có code worker) ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
# BẮT BUỘC đổi ở mọi môi trường ngoài máy dev của bạn.
# Sinh key mới: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Giới hạn CORS khi deploy (code hiện tại đang allow_origins=["*"] — xem ARCHITECTURE.md §8):
CORS_ORIGINS=http://localhost:3000

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=DrawPath AI

# --- Object storage (MinIO / S3-compatible) — OPTIONAL, chưa tích hợp code ---
# Chỉ dùng khi chạy compose với --profile minio và sau khi tích hợp S3.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=drawpath
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- AI providers — TẤT CẢ OPTIONAL ---
# Để trống: hệ thống dùng local-CV + Pollinations (keyless).
# Có key: fallback chain local-cv -> Pollinations -> HuggingFace -> OpenRouter -> OpenAI-compat.
OPENROUTER_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Seed ---
# true = tạo tài khoản demo khi backend startup (chỉ local).
# Tài khoản seed THẬT trong code (backend/app/seed.py):
#   admin@drawpath.local / admin123  |  learner@drawpath.local / learner123
# Production nên đặt false hoặc đổi mật khẩu ngay sau khi tạo.
SEED_DEMO_USERS=true
